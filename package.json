{
  "name": "shopwiz",
  "version": "1.0.0",
  "private": true,
  "description": "Shared shopping lists without login or tracking",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./jsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/instrument-sans": "^5.0.0",
    "@playwright/test": "^1.50.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.6",
    "flag-icons": "^7.5.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
