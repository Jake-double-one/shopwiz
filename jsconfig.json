{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "checkJs": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["svelte"]
  },
  "include": ["client/src/**/*.js", "client/src/**/*.svelte", "shared/**/*.js"]
}
